# Generated by npx convex dev; no secrets belong in VITE_* variables.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Configure on the Convex deployment (see README), never in browser code:
# AUTH_PRIVATE_KEY, AUTH_JWKS (npx @convex-dev/auth)
# AUTH_GOOGLE_CLIENT_ID, AUTH_GOOGLE_CLIENT_SECRET, AUTH_ALLOWED_ORIGINS
# R2_BUCKET, R2_ENDPOINT, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY
# CLOUD_USER_BYTE_LIMIT=250000000
# CLOUD_APP_BYTE_LIMIT=8000000000

# Convex deployment environment (server-side only):
# OWNER_GOOGLE_ACCOUNT_ID=<verified Google provider account ID>
# ADMIN_USER_IDS=<additional comma-separated Convex Auth user IDs>

# Music metadata (Convex deployment only; never VITE_*):
# ACOUSTID_API_KEY=<application key from acoustid.org/new-application>
# MUSICBRAINZ_ENABLED=true  # opt in after confirming permitted provider access
