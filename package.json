{
  "name": "woodshed",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Practice along to songs — pull a track, split it into stems with Demucs, and play back with per-stem mute/solo, waveforms, looping and speed control.",
  "author": "Kyle Kincer",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n convex,vite -c blue,green \"convex dev\" \"vite\"",
    "dev:web": "vite",
    "dev:convex": "convex dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "convex deploy --cmd 'npm run build'",
    "companion": "node companion/server.mjs",
    "companion:setup": "python3.11 companion/setup.py --beats",
    "test": "vitest run",
    "test:motion": "node --test tests/motion.test.mjs",
    "test:artwork": "node --test tests/artwork.test.mjs",
    "typecheck": "tsc --noEmit -p convex/tsconfig.json",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dev": "npm run build && npm run desktop:prepare && electron .",
    "desktop:package": "npm run build && npm run desktop:prepare && electron-builder --publish never",
    "test:desktop": "node --test desktop/*.test.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@convex-dev/auth": "2.0.0-alpha.1",
    "@convex-dev/r2": "^0.10.2",
    "@convex-dev/stripe": "^0.1.6",
    "convex": "^1.43.0",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "stripe": "^22.6.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.1.2",
    "concurrently": "^10.0.4",
    "convex-test": "^0.0.56",
    "dotenv": "^17.2.3",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "happy-dom": "^20.14.0",
    "js-yaml": "^4.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.0"
  },
  "main": "desktop/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/KyleKincer/woodshed.git"
  }
}
