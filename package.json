{
  "name": "woodshed",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Practice along to songs — pull a track, split it into stems with Demucs, and play back with per-stem mute/solo, waveforms, looping and speed control.",
  "author": "Kyle Kincer",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n convex,vite -c blue,green \"convex dev\" \"vite\"",
    "dev:web": "vite",
    "dev:convex": "convex dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "convex deploy --cmd 'npm run build'",
    "modal:deploy": "modal deploy modal/separate.py && modal deploy modal/beats.py",
    "migrate": "node scripts/migrate-local.mjs"
  },
  "dependencies": {
    "@clerk/clerk-js": "^6.25.13",
    "@clerk/ui": "^1.27.2",
    "@convex-dev/r2": "^0.10.2",
    "convex": "^1.43.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@types/node": "^26.1.2",
    "concurrently": "^10.0.4",
    "dotenv": "^17.2.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  }
}
