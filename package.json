{
  "name": "woodshed",
  "version": "1.0.0",
  "description": "Practice along to songs — pull a track, split it into stems with Demucs, and play back with per-stem mute/solo, waveforms, looping and speed control.",
  "main": "main.js",
  "author": "Kyle Kincer",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "try": "./scripts/build-local.sh",
    "try:dmg": "./scripts/build-local.sh --dmg",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "release": "./scripts/release.sh",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "build": {
    "appId": "com.kylekincer.woodshed",
    "productName": "Woodshed",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "mac": {
      "category": "public.app-category.music",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "target": [
        "AppImage"
      ],
      "category": "Audio"
    }
  }
}
